# Copia questo file in .env e scegli le tue password locali.
# .env è escluso dal repository: non va mai condiviso né incollato in chat o nei log.

# Porte sul tuo PC: cambiale se sono già occupate (per esempio da un PostgreSQL installato)
POSTGRES_PORT=5432
MONGO_PORT=27017

# PostgreSQL: amministratore e utenti dei servizi Bookings e Users
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
BOOKINGS_DB_PASSWORD=
USERS_DB_PASSWORD=

# MongoDB: amministratore e utente del servizio Spaces
MONGO_ADMIN_USER=mongoadmin
MONGO_ADMIN_PASSWORD=
SPACES_DB_PASSWORD=
