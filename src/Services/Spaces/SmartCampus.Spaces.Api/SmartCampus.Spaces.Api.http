@SmartCampus.Spaces.Api_HostAddress = http://localhost:5101
# Nota autenticazione JWT (sviluppo locale):
# Per usare token emessi da Users con una chiave personalizzata, impostare la stessa Jwt:SigningKey
# anche su Spaces:
#   dotnet user-secrets set "Jwt:SigningKey" "<stessa-chiave-di-Users-e-Bookings>" --project src/Services/Spaces/SmartCampus.Spaces.Api

### Health check
GET {{SmartCampus.Spaces.Api_HostAddress}}/health

### Ricerca catalogo spazi (tutti gli spazi attivi)
GET {{SmartCampus.Spaces.Api_HostAddress}}/spaces
Accept: application/json

### Ricerca catalogo con filtri combinati (tipo, modalità, capienza minima, strumenti, software)
GET {{SmartCampus.Spaces.Api_HostAddress}}/spaces?type=Lab&mode=Dedicated&minCapacity=20&equipment=videoprojector&software=Docker
Accept: application/json

### Dettaglio singolo spazio per ID
GET {{SmartCampus.Spaces.Api_HostAddress}}/spaces/3f2a9c1e-0000-4000-8000-000000000002
Accept: application/json

### Verifica prenotabilità spazio (Aula 101 - disponibile)
GET {{SmartCampus.Spaces.Api_HostAddress}}/spaces/3f2a9c1e-0000-4000-8000-000000000001/bookable?from=2026-10-28T09:00:00Z&to=2026-10-28T11:00:00Z
Accept: application/json

### Verifica prenotabilità spazio con manutenzione (Aula 205)
GET {{SmartCampus.Spaces.Api_HostAddress}}/spaces/3f2a9c1e-0000-4000-8000-000000000008/bookable?from=2026-10-28T09:00:00Z&to=2026-10-28T11:00:00Z
Accept: application/json

### Creazione nuovo spazio (solo ruolo Admin - sostituire <ADMIN_JWT>)
POST {{SmartCampus.Spaces.Api_HostAddress}}/spaces
Authorization: Bearer <ADMIN_JWT>
Content-Type: application/json

{
  "name": "Aula 301",
  "type": "Classroom",
  "mode": "Mixed",
  "building": "Edificio C",
  "floor": 3,
  "capacity": 20,
  "equipment": ["videoprojector", "interactive-whiteboard"],
  "features": {
    "projector": true,
    "movableDesks": true
  }
}

### Modifica spazio esistente (solo ruolo Admin)
PUT {{SmartCampus.Spaces.Api_HostAddress}}/spaces/3f2a9c1e-0000-4000-8000-000000000001
Authorization: Bearer <ADMIN_JWT>
Content-Type: application/json

{
  "name": "Aula 101 Rinnovata",
  "type": "Classroom",
  "mode": "Dedicated",
  "building": "Edificio A",
  "floor": 1,
  "capacity": 35,
  "equipment": ["videoprojector", "audio-kit"],
  "features": {
    "blackboard": true,
    "projector": true
  }
}

### Disattivazione spazio (solo ruolo Admin)
POST {{SmartCampus.Spaces.Api_HostAddress}}/spaces/3f2a9c1e-0000-4000-8000-000000000001/deactivate
Authorization: Bearer <ADMIN_JWT>

### Elenco indisponibilità di uno spazio (pubblico, con filtro periodo opzionale)
GET {{SmartCampus.Spaces.Api_HostAddress}}/spaces/3f2a9c1e-0000-4000-8000-000000000008/unavailabilities
Accept: application/json

### Aggiunta indisponibilità su uno spazio (solo ruolo Admin)
POST {{SmartCampus.Spaces.Api_HostAddress}}/spaces/3f2a9c1e-0000-4000-8000-000000000001/unavailabilities
Authorization: Bearer <ADMIN_JWT>
Content-Type: application/json

{
  "start": "2026-10-29T08:00:00Z",
  "end": "2026-10-29T12:00:00Z",
  "reason": "Manutenzione straordinaria impianto climatizzazione"
}

### Rimozione indisponibilità (solo ruolo Admin)
DELETE {{SmartCampus.Spaces.Api_HostAddress}}/spaces/3f2a9c1e-0000-4000-8000-000000000008/unavailabilities/8c1d2e3f-4a5b-6c7d-8e9f-0a1b2c3d4e01
Authorization: Bearer <ADMIN_JWT>
